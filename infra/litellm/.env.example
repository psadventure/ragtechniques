# LiteLLM gateway settings. Copy to infra/litellm/.env (gitignored) and fill in,
# or let scripts/setup.sh generate it. Never commit .env.

# ── Required ─────────────────────────────────────────────────────────────────
# Admin key for the gateway (UI login, minting virtual keys). Generate with:
#   echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=
# Encrypts credentials stored in Postgres. Generate the same way.
# Keep it: changing it later makes stored credentials unreadable.
LITELLM_SALT_KEY=
# Your GCP project with the Vertex AI API enabled.
VERTEX_PROJECT=
# Vertex region for the models in config/config.yaml.
VERTEX_LOCATION=us-east1

# ── Recommended ──────────────────────────────────────────────────────────────
# Listen on this machine only (empty = all interfaces). Keep the trailing colon.
LITELLM_BIND=127.0.0.1:

# ── Optional (unset = value in parentheses) ──────────────────────────────────
# Host port for the gateway                                        (4000)
# LITELLM_PORT=4000
# gcloud Application Default Credentials file to mount read-only
#                    (~/.config/gcloud/application_default_credentials.json)
# GCLOUD_ADC_PATH=
# Password of the gateway's internal Postgres (not exposed outside Docker)  (litellm)
# POSTGRES_PASSWORD=

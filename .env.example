# RAGAdvanced app settings. Copy to .env (gitignored): `cp .env.example .env`
# or let scripts/setup.sh create and fill it. Never commit .env.

# ── Required for hosted models (Vertex AI via the LiteLLM gateway) ───────────
# Not needed if you only use the local `minilm` embedder and retrieval without answers.
LITELLM_BASE_URL=http://localhost:4000
# A LiteLLM *virtual key* (sk-...), never the master key. setup.sh mints one for you;
# manually: see README.md → "LiteLLM gateway" → "Mint the app's key by hand".
LITELLM_API_KEY=

# ── Optional: defaults (unset = value in parentheses) ────────────────────────
# Embedder for ingestion: minilm | text-embedding-005 | gemini-embedding-001   (minilm)
# RAG_EMBEDDER=minilm
# Gateway alias used for answers and the agent                                  (gemini-2.5-flash)
# RAG_CHAT_MODEL=gemini-2.5-flash
# Answer generator: litellm | anthropic | openai                                (litellm)
# RAG_GENERATOR=litellm

# ── Optional: chunking & retrieval defaults ──────────────────────────────────
# Per-experiment overrides (agent / demo flags) still win over these.
# RAG_CHAR_CHUNK_SIZE=500
# RAG_CHAR_CHUNK_OVERLAP=50
# RAG_STRUCTURE_MAX_WORDS=400
# RAG_TOP_K=5
# RAG_RRF_K=60

# ── Optional: direct providers (only when RAG_GENERATOR=anthropic|openai) ────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
